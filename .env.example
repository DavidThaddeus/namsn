# Copy this file to .env.local and fill in real values.
# Never commit .env.local — it's gitignored on purpose.

# Supabase project URL and anon/public key.
# Find both under: Supabase dashboard -> Project Settings -> API.
# These two are safe to expose in the browser (same trust level the old
# Firebase config values had) — never put the service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role key — Supabase dashboard -> Project Settings -> API.
# Server-only. Bypasses Row Level Security entirely. NEVER prefix this with
# NEXT_PUBLIC_ and never let it reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Bachs (Phase 4 payments) secret key — Bachs dashboard -> Developer Portal.
# Server-only, same rule as above. Use a sk_sandbox_... key until go-live.
BACHS_SECRET_KEY=

# Signing secret for the /api/dues/webhook endpoint, shown once when the
# webhook is created in the Bachs Developer Portal (or via the API).
BACHS_WEBHOOK_SECRET=

# Real public domain — Bachs rejects localhost for payment redirect URLs.
SITE_URL=
